# Copia este archivo como .env y completa los valores. Reinicia `npm run dev` tras editarlo.
# Las variables VITE_ llegan al navegador (son públicas). Las demás solo las leen las funciones de /api.

# ── EmailJS (aviso por correo de cada cotización) ──
# La plantilla usa {{nombre}}, {{telefono}}, {{correo}}, {{vehiculo}}, {{fecha}}, {{mensaje}} y {{time}}.
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxx

# ── Supabase (cuentas, cotizaciones y reservas) ──
# Settings → API del proyecto. La URL y la clave anon son públicas.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# SECRETA: solo para el servidor. Nunca con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Mercado Pago (reserva de vehículos) ──
# SECRETO: Access Token de las credenciales de prueba (TEST-...). Solo para el servidor.
MP_ACCESS_TOKEN=
# Monto de la reserva en soles (servidor y sitio). Por defecto 300.
RESERVA_MONTO=300
VITE_RESERVA_MONTO=300
